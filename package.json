{
  "name": "pizza-courier",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.26",
    "expo-application": "~57.0.3",
    "expo-haptics": "~57.0.3",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "puppeteer-core": "^25.12.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "postinstall": "node scripts/build-web.mjs",
    "prestart": "node scripts/build-web.mjs",
    "start": "expo start",
    "web:watch": "node scripts/build-web.mjs --watch",
    "solve": "node scripts/solve-levels.mjs",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "smoke": "node scripts/smoke-test.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "icons": "node scripts/make-icons.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "verify": "npm run typecheck && npm run lint && npm test && npm run smoke"
  },
  "private": true
}
